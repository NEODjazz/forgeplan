{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "forgeplan"
    },
    "schema_version": {
      "const": 1
    },
    "project": {
      "$ref": "#/$defs/project"
    }
  },
  "required": [
    "format",
    "schema_version",
    "project"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgePlan native document schema 1",
  "$defs": {
    "id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "moment": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "day": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interval"
      },
      "maxItems": 24
    },
    "week": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/day"
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/date"
        },
        "start_minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "utc_offset": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "weekly": {
          "$ref": "#/$defs/week"
        },
        "holidays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/date"
          }
        },
        "exceptions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/day"
          }
        }
      },
      "required": [
        "start",
        "start_minute",
        "utc_offset",
        "weekly",
        "holidays",
        "exceptions"
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "SNET",
            "SNLT",
            "FNET",
            "FNLT",
            "MSO",
            "MFO"
          ]
        },
        "at": {
          "$ref": "#/$defs/moment"
        }
      },
      "required": [
        "kind",
        "at"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48000000
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "kind": {
          "enum": [
            "task",
            "summary"
          ]
        },
        "constraint": {
          "anyOf": [
            {
              "$ref": "#/$defs/constraint"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/moment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "duration",
        "parent",
        "order",
        "kind"
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "relation": {
          "enum": [
            "FS",
            "SS",
            "FF",
            "SF"
          ]
        },
        "lag": {
          "type": "integer",
          "minimum": -48000000,
          "maximum": 48000000
        }
      },
      "required": [
        "from",
        "to",
        "relation",
        "lag"
      ]
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/date"
        },
        "through": {
          "$ref": "#/$defs/date"
        },
        "capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "from",
        "through",
        "capacity"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "person",
            "generic"
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "availability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/availability"
          },
          "maxItems": 5000
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "capacity",
        "availability"
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "$ref": "#/$defs/id"
        },
        "resource": {
          "$ref": "#/$defs/id"
        },
        "units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "task",
        "resource",
        "units"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "fixed_duration",
            "fixed_work",
            "fixed_units"
          ]
        },
        "effort_driven": {
          "type": "boolean"
        },
        "target_work_basis": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "effort_driven",
        "target_work_basis"
      ]
    },
    "personal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weekly": {
          "$ref": "#/$defs/week"
        },
        "exceptions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/day"
          }
        }
      },
      "required": [
        "weekly",
        "exceptions"
      ]
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "percent_complete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "work_basis": {
          "type": "integer",
          "minimum": 0
        },
        "cost_cents": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/moment"
            },
            {
              "type": "null"
            }
          ]
        },
        "finish": {
          "anyOf": [
            {
              "$ref": "#/$defs/moment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "percent_complete",
        "work_basis",
        "cost_cents",
        "start",
        "finish"
      ]
    },
    "baseline_task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "$ref": "#/$defs/moment"
        },
        "finish": {
          "$ref": "#/$defs/moment"
        },
        "es": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48000000
        },
        "ef": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48000000
        },
        "work_basis": {
          "type": "integer",
          "minimum": 0
        },
        "cost_cents": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "start",
        "finish",
        "es",
        "ef",
        "work_basis",
        "cost_cents"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baseline_task"
          },
          "maxItems": 2000
        }
      },
      "required": [
        "name",
        "calendar",
        "tasks"
      ]
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/policy"
          }
        },
        "resource_calendars": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/personal"
          }
        },
        "hourly_rates_cents": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          }
        },
        "fixed_costs_cents": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "actuals": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/actual"
          }
        },
        "baselines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baseline"
          },
          "maxItems": 20
        },
        "active_baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/moment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": []
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          },
          "maxItems": 2000
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "maxItems": 20000
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 200
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignment"
          },
          "maxItems": 10000
        },
        "management": {
          "$ref": "#/$defs/management"
        }
      },
      "required": [
        "title",
        "calendar",
        "tasks",
        "links",
        "resources",
        "assignments"
      ]
    }
  },
  "description": "Structural schema; referential, calendar, monetary overflow and graph invariants are also validated by Rust."
}
